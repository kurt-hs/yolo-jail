// The `git-broker` loophole, shipped by the OFFICIAL `git` pack: a host daemon that connects to
// one jail's approved git remotes the way the host does, on its behalf
// (docs/design/git-broker.md, docs/design/git-broker-plan.md task 7). The daemon is
// internal/gitbroker, reached from the jail through git's own remote-helper protocol: the
// pack's `env` contribution rewrites ssh://, https:// and git@ remotes to `yolo::<url>`, so the
// jail's real git runs `git-remote-yolo`, which the pack's `intercept` forwards to
// `yolo git-remote --` (ID-4).
//
// THE CREDENTIAL NEVER CROSSES; THE PROTOCOL DOES. The jail sends a service and the remote URL;
// the broker checks the URL against the scope the launch approved, connects to the approved
// string with the host's ssh, streams a fetch back, and reads a push's ref commands before
// forwarding anything. A push lands only where a grant or the working set covers every ref
// (ID-9: creating a branch under a create-branch grant, then updating or deleting a branch the
// broker created or a branch grant in the workspace config declares, GB-D12); every
// other push is refused per ref, and every call is audited.
{
  "name": "git-broker",
  "description": "Run the jail's git fetch and push through the host's own credentials (its SSH keys or agent for SSH remotes, its git credential helper for HTTPS ones), only against this workspace's git remotes as approved at launch, and only under a read grant in config (brokered.git.grants; with none, every call is refused): fetches stream back, a push lands only on a branch a create-branch grant lets it create or one in its working set (a branch it created that way, or one a branch grant in the workspace config declares; yolo approve lists them), every other push is refused per ref (push from the host), and every call is audited on the host (yolo audit --service git).",
  "version": 1,

  // NO SWITCH, AND NO ACCESS BY DEFAULT (boundary-broker.md BB-D104 to BB-D106, git-broker.md
  // GB-D15). A `brokered` loophole runs whenever its pack is selected, so selecting the pack
  // starts the broker and serves the remote rewrite (ID-6) in every workspace, and the broker
  // grants nothing: every fetch and push is refused until a read grant covers the remote. The
  // usual one is the user config's `"brokered": {"git": {"grants": [{"kind": "read", "repo":
  // "*"}]}}`, which each workspace's config-change prompt or `yolo config apply` shows and a
  // human approves. That is why this manifest has no `default_enabled`.

  "transport": "loopback-tls",
  "lifecycle": "spawned",

  // THE REPOSITORY SCOPE (loopholedecl/brokered.go, ID-2). `remote_host: "*"` makes core read
  // every remote of the workspace, on any host, `url` and `pushurl` alike, and put each URL in
  // the config-change prompt verbatim; the scope file records what a human approved with
  // `"form": "remote-url"`, and the broker connects only to an approved string. The credential
  // paths are where the host keeps what git authenticates with; with this pack selected, a
  // workspace `mounts` entry reaching one is refused (BB-D26, ID-12).
  "brokered": {
    "source": "git",
    "remote_host": "*",
    // The grant kinds this source defines beside `read`, which every source defines (ID-10,
    // BB-D107): a workspace grant of one, allowed by the user config's `brokered.git.grant_kinds`,
    // lets the broker create branches under refs/heads/ in the granted repository
    // (`create-branch`, ID-9), or puts the one branch it names in the workspace's working set,
    // declared in config (`branch`, git-broker.md GB-D12, GB-D13).
    "grants": ["create-branch", "branch"],
    "credential_paths": ["~/.ssh", "$SSH_AUTH_SOCK", "~/.git-credentials", "~/.config/git/credentials"]
  },

  // One daemon per jail, behind yolo's front, with the connection preamble on: every audit line
  // keys on the preamble's host-asserted jail id, never on a request field (BB-D1).
  "host_daemon": {
    "cmd": [
      "yolo", "internal", "daemon", "git-broker",
      "--socket", "{socket}",
      "--scope-file", "{repository_scope}"
    ],
    "publishes": "socket"
  },

  // `yolo check` asks the daemon which host ssh and git it would run.
  "doctor_cmd": [
    "yolo", "internal", "daemon", "git-broker", "--self-check"
  ]
}
