// The `github-broker` loophole, shipped by the OFFICIAL `github` pack: a host daemon that
// runs the host's own `gh` login on one jail's behalf, only against the workspace's GitHub
// repositories, its remotes and its approved `brokered.github.repos` entry
// (docs/design/boundary-broker.md, step 1 of its §11; docs/design/workspace-widening.md). The
// daemon is internal/ghbroker, reached from the jail through `yolo gh`, which the pack's
// `intercept` contribution puts in front of the image's own `gh`.
//
// THE CREDENTIAL NEVER CROSSES; THE COMMAND DOES (BB-P1). The jail sends an argv; the
// daemon parses it against gh's measured flag grammar, refuses what could print the token or
// reach the host, checks its repository against the scope the launch approved, and runs the
// host gh with a canonical argv in an empty directory. Step 1 runs the read-only set and
// answers every write with exit 77.
{
  "name": "github-broker",
  "description": "Run the host's gh login for the jail against this workspace's GitHub repositories, its remotes and any its config lists under brokered.github.repos, as approved at launch, and only under a read grant in config (brokered.github.grants; with none, every call is refused): read-only commands run, a write exits 77 at once because its approval step is not built yet (run it on the host), and every call is audited on the host (yolo audit).",
  "version": 1,

  // NO SWITCH, AND NO ACCESS BY DEFAULT (boundary-broker.md BB-D104 to BB-D106). A `brokered`
  // loophole runs whenever its pack is selected, so selecting the pack installs the `gh`
  // forwarder and starts the broker in every workspace, and the broker grants nothing: every
  // call is refused until a read grant covers the repository. The usual one is the user
  // config's `"brokered": {"github": {"grants": [{"kind": "read", "repo": "*"}]}}`, which each
  // workspace's config-change prompt or `yolo config apply` shows and a human approves. That is
  // why this manifest has no `default_enabled`.

  "transport": "loopback-tls",
  "lifecycle": "spawned",

  // No `requires` on gh, deliberately and for journal's reason (R3): a host without gh is a
  // real machine, and the honest report there is the broker answering every call with exit
  // 69, "the host has no gh", rather than a loophole that vanishes from `yolo loopholes list`.

  // THE REPOSITORY SCOPE (loopholedecl/brokered.go). Core reads the workspace's remotes on
  // github.com and its config's `brokered.github.repos` entry at every fresh launch that starts
  // this daemon, puts them in the config-change prompt as a labeled block, writes what a human
  // approved to that launch's scope file, and hands the file to the daemon through
  // {repository_scope}. The credential paths are where the host gh keeps its login (gh's own
  // precedence: $GH_CONFIG_DIR, then $XDG_CONFIG_HOME/gh, then ~/.config/gh); with this pack
  // selected, a workspace `mounts` entry reaching one is refused (BB-D26).
  "brokered": {
    "source": "github",
    "remote_host": "github.com",
    "credential_paths": ["$GH_CONFIG_DIR", "$XDG_CONFIG_HOME/gh", "~/.config/gh"],
    "read_capability": "read",
    "kind_capabilities": {"create-pr": "create_pr", "create-issue": "create_issue"},
    "pending_capabilities": ["create_pr", "create_issue"]
  },

  // One daemon per jail, behind yolo's front, with the connection preamble on: every grant
  // and every audit line keys on the preamble's host-asserted jail id, never on a request
  // field (BB-D1). `scope` stays at its default, `jail` — a brokered daemon's scope file is
  // one launch's approval, so a host-wide one is refused at load.
  "host_daemon": {
    "cmd": [
      "yolo", "internal", "daemon", "github-broker",
      "--socket", "{socket}",
      "--scope-file", "{repository_scope}"
    ],
    "publishes": "socket"
  },

  // `yolo check` asks the daemon which host gh it would run, its version, and whether it can
  // read a login.
  "doctor_cmd": [
    "yolo", "internal", "daemon", "github-broker", "--self-check"
  ]
}
