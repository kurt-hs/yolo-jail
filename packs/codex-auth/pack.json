    {
      "from": "loopholes/openai-auth-broker",
      "kind": "loophole"
    },
    {
      "capabilities": [
        "web_search"
      ],
      "endpoints": {
        "openai-responses": {
          "base_url": "https://chatgpt.com/backend-api/codex",
          "wire_api": "openai-responses"
        }
      },
      "kind": "provider",
      "pinned_endpoint": true,
      "model_options": {
        "gpt-6-astra": {
          "context_window": "272000",
          "description": "Frontier",
          "long_context_window": "1000000",
          "name": "GPT-6 Astra",
          "order": "2"
        },
        "gpt-6-luna": {
          "context_window": "272000",
          "description": "Fast",
          "long_context_window": "1000000",
          "name": "GPT-6 Luna",
          "order": "3"
        },
        "gpt-6.1-sol": {
          "context_window": "272000",
          "description": "Balanced",
          "long_context_window": "1000000",
          "name": "GPT-6.1 Sol",
          "order": "1"
        }
      },
      "models": {
        "gpt-6-astra": "gpt-6-astra",
        "gpt-6-luna": "gpt-6-luna",
        "gpt-6.1-sol": "gpt-6.1-sol"
      },
      "name": "openai-codex"
    },
    {
      "kind": "profile",
      "name": "codex",
      "provider": "openai-codex"
    }
  ],
  "description": "The OpenAI (ChatGPT) subscription as one provider and profile, and the one machine-wide owner for its login and refresh-token rotation. It installs nothing; the codex pack brings it, and you may select it without codex.",
  // The name this pack had before OQ-PE3 (docs/design/provider-enablement.md PE-D7): a config
  // still naming it is refused naming this one. The pinned endpoint is PE-D4: the bridge routes
  // claude through it, and a user providers.openai-codex entry may not re-point it.
  "formerly": {
    "packs": ["openai-auth"]
  },
  "name": "codex-auth"
}
